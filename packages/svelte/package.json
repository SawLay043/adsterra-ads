{
  "name": "@adsterra-ad/svelte",
  "version": "0.1.0",
  "type": "module",
  "svelte": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adsterra-ad/core": "0.1.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}